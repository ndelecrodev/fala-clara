# Normalização de fim de linha: texto sempre com LF
* text=auto eol=lf

# Código e documentação
*.md     text diff=markdown
*.py     text diff=python
*.ts     text
*.tsx    text
*.css    text diff=css
*.html   text diff=html
*.json   text
*.yml    text
*.yaml   text
*.toml   text
*.svg    text
*.sh     text eol=lf

# Binários
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary

# Arquivos gerados: sem diff ruidoso e fora das estatísticas de linguagem
uv.lock                 -diff linguist-generated
web/package-lock.json   -diff linguist-generated

# Documentação não conta nas estatísticas de linguagem do GitHub
docs/**  linguist-documentation
